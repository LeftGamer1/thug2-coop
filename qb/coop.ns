script coop_teleport_request {
    if (coop_cam_frozen = 1) {
        CoopLog "teleport key: unfreezing the camera hold"
        change coop_intro_held = 0
        coop_cam_unfreeze
        coop_message text="Co-op: unstuck"
        return
    }
    if GoalManager_HasActiveGoals {
        coop_message text="Co-op: no teleport during a goal"
        return
    }
    if ! CoopTeleportToFriend {
        coop_message text="Co-op: no friend in the level"
    }
    wait 2 gameframes
    CoopLogPositions
}
script coop_debug_pos {
    CoopLogPositions
}
script coop_friend_label {
    if ScreenElementExists id=coop_friend_name {
        SetScreenElementProps id=coop_friend_name text=<text> pos=<pos>
    } else {
        SetScreenElementLock id=root_window OFF
        CreateScreenElement {
            Type=TextElement
            parent=root_window
            id=coop_friend_name
            font=small
            text=<text>
            pos=<pos>
            just=[center bottom]
            scale=0.9
            rgba=[90 170 255 100]
            z_priority=3
        }
    }
}
script coop_debug_points {
    GoalManager_GetActiveRewardPoints
    FormatText TextName=msg "debug: active=%a total=%t cheat=%c" a=<active_points> t=<total_points> c=total_cheat_points
    CoopLog <msg>
}

script select_pro_menu_choose {
    if CoopIsActive {
        if CoopIsHost {
            CoopSendSpawn call=coop_remote_select_pro params={<...>}
        } else {
            if ! CoopIsRemote {
                coop_message text="Co-op: the host picks the teammate"
                return
            }
        }
    }
    coop_orig_select_pro_menu_choose <...>
}
script coop_remote_select_pro {
    if ScreenElementExists id=current_menu_anchor {
        DestroyScreenElement id=current_menu_anchor
    }
    select_pro_menu_choose <...>
}
script coop_orig_select_pro_menu_choose {
    if ! GotParam teammate_pro_appearance_name {
        script_assert "no teammate pro appearance name specified in skater profile!"
    }
    if ! ChecksumEquals a=(skater_swapping_teammate_name) b=None {
        SetSwappedSkaterName profile_name=<name>
        RefreshSwappedSkaterData
    }
    change skater_swapping_teammate_name=<name>
    if MemHeapExists name=TeammatePro {
        mempushcontext TeammatePro
        <swappable_pro_name> = TRG_Ped_TeammatePro
        if CompositeObjectExists name=<swappable_pro_name> {
            if GetSkaterModelIsSwapped {
                <skater_swapped> = 1
            } else {
                <skater_swapped> = 0
            }
            if (<skater_swapped> = 1) {
                SwapObjectModels obj_1=skater obj_2=<swappable_pro_name>
            }
            <swappable_pro_name>:Obj_ClearGeoms
            <swappable_pro_name>:Obj_ShadowOff
            <swappable_pro_name>:Obj_InitModelFromProfile {
                texDictOffset=800
                use_asset_manager=0
                struct=<teammate_pro_appearance_name>
                buildscript=create_ped_model_from_appearance
            }
            <swappable_pro_name>:Obj_ResetNoSuspendCount
            if (<skater_swapped> = 1) {
                SwapObjectModels obj_1=skater obj_2=<swappable_pro_name>
            }
        } else {
            printf "Couldn't find teammate pro to switch"
        }
        mempopcontext
    } else {
        script_assert "Where's the teammate pro heap?"
    }
    if GoalManager_GoalIsActive name=BO_Goal_Gaps7 {
        skater:remove_all_anim_subsets
        GoalManager_LoseGoal name=BO_Goal_Gaps7
    }
    SafeCallback <...> mark_first_input
}

script create_select_pro_menu {
    if CoopIsActive {
        if ! CoopIsHost {
            GetChapterSelectableProCount
            if (<selectable_pro_count> > 1) {
                coop_message text="Co-op: waiting for the host to pick the teammate..."
                return
            }
        }
    }
    coop_orig_create_select_pro_menu <...>
}
script coop_orig_create_select_pro_menu {
    if GotParam from_chapter_intro {
        callback = StartCurrentChapterWelcome
    } else {
        callback = exit_pause_menu
    }
    GetCurrentChapterInfo
    if ! LevelIs <level> {
        SafeCallback <...>
        return
    }
    if ! GotParam selectable_pros {
        printf "No pro list found!"
        SetCurrentTeammateProAppearanceName
        SafeCallback <...>
        return
    }
    GetArraySize <selectable_pros>
    if (<array_size> = 0) {
        printf "Empty pro list - setting to null"
        SafeCallback <...>
        return
    } else {
        if (<array_size> = 1) {
            printf "Setting only pro found"
            SetCurrentTeammateProAppearanceName pro=(<selectable_pros> [0])
            SafeCallback <...>
            return
        }
    }
    if GotParam from_chapter_intro {
        SetUpChapterMenu
        pad_back = nullscript
        helpers = generic_helper_text_no_back
    } else {
        pad_back = generic_menu_pad_back
        helpers = generic_helper_text
    }
    make_new_roundbar_menu {
        title="SELECT PRO TEAMMATE"
        pad_back_script=<pad_back>
        pad_back_params={callback=<callback>}
        helper_text=<helpers>
        additional_focus_script=focus_stats_display
        additional_unfocus_script=unfocus_stats_display
    }
    pause_menu_gradient
    index = 0
    while {
        FormatText ChecksumName=item "menu_item_%i" i=<index>
        GetSkaterProfileInfoByName name=(<selectable_pros> [<index>])
        add_roundbar_menu_item {text=<display_name>
            id=<item>
            pad_choose_script=select_pro_menu_choose
            pad_choose_params={pro=(<selectable_pros> [<index>]) <...>}
            mark_first_input
        }
        <item>:SetTags name=(<selectable_pros> [<index>])
        <index> = (<index> + 1)
    } <array_size>
    roundbar_menu_finish
}

script coop_debug_introcams {
    CoopLog "debug: intro cams start"
    GetCurrentChapterInfo
    PlayIntroCameras <...>
    CoopLog "debug: intro cams done"
}
script coop_friend_label_hide {
    if ScreenElementExists id=coop_friend_name {
        DestroyScreenElement id=coop_friend_name
    }
}
coop_cam_frozen = 0
script coop_play_cam_anim {
    if GoalManager_HasActiveGoals {
        return
    }
    PlaySkaterCamAnim <...>
    coop_cam_freeze
}
script coop_cam_freeze {
    if (coop_cam_frozen = 1) {
        if ! GotParam again {
            return
        }
    }
    if ! GoalManager_HasActiveGoals {
        skater:PausePhysics
        hide_all_hud_items dont_restore_input
    }
    if (coop_cam_frozen = 0) {
        change coop_cam_frozen = 1
        SpawnScript coop_cam_freeze_watch
    }
}
script coop_cam_freeze_watch {
    idle = 0
    total = 0
    while {
        wait 1 gameframe
        total = (<total> + 1)
        if (<total> > 3600) {
            CoopLog "camera hold: over a minute, let go"
            change coop_intro_held = 0
            break
        }
        if SkaterCamAnimFinished {
            idle = (<idle> + 1)
        } else {
            idle = 0
        }
        if (coop_intro_held = 1) {
            if (<idle> > 900) {
                change coop_intro_held = 0
            }
        } else {
            if (<idle> > 30) {
                break
            }
        }
    }
    coop_cam_unfreeze
}
coop_intro_held = 0
script coop_intro_hold {
    change coop_intro_held = 1
    coop_cam_freeze again
}
script coop_remote_intro_begin {
    coop_intro_hold
    if GotParam letterbox {
        fake_letterboxing
    }
}
script coop_remote_intro_end {
    change coop_intro_held = 0
}
script coop_cam_unfreeze {
    if (coop_cam_frozen = 0) {
        return
    }
    change coop_cam_frozen = 0
    if ScreenElementExists id=intro_panel {
        DestroyScreenElement id=intro_panel
    }
    if ScreenElementExists id=coop_cam_text_anchor {
        DestroyScreenElement id=coop_cam_text_anchor
    }
    fake_letterboxing remove
    skater:UnpausePhysics
    show_all_hud_items
}
script coop_remote_intro_text {
    coop_cam_freeze again
    if ScreenElementExists id=intro_panel {
        DestroyScreenElement id=intro_panel
    }
    if GotParam text {
        create_panel_block {id=intro_panel
            text=<text>
            rgba=[128 128 128 128]
            pos=(12.0, 395.0)
            time=<time>
            dims=(616.0, 0.0)
            just=[left center]
            internal_just=[center top]
            parent=root_window
        }
    } else {
        if GotParam goal {
            GoalManager_GetGoalParams name=<goal>
            FormatText TextName=goal_desc "\\c0%a - \\c5%b PTS." a=<view_goals_text> b=<reward_points>
            create_intro_panel_block {id=intro_panel
                text=<goal_desc>
                rgba=[8 97 121 128]
                pos=(12.0, 395.0)
                time=1000000
                dims=(616.0, 0.0)
                just=[left center]
                internal_just=[center top]
                parent=root_window
                create_bg
            }
        }
    }
    if GotParam cam_start_script {
        <cam_start_script>
    }
}
script coop_remote_cam_text {
    coop_cam_freeze again
    if ScreenElementExists id=goal_description_anchor {
        return
    }
    if GoalManager_HasActiveGoals {
        return
    }
    create_speech_box {
        anchor_id=coop_cam_text_anchor
        text=<text>
        pos=<pos>
        bg_x_scale=1.3
        no_pad_choose
        no_pad_start
    }
}
script speech_box_style {
    if CoopIsActive {
        if (<anchor_id> = goal_description_anchor) {
            if ScreenElementExists id=coop_cam_text_anchor {
                DestroyScreenElement id=coop_cam_text_anchor
            }
            CoopSendSpawn call=coop_remote_cam_text params={text=<text> pos=<pos>}
        }
    }
    coop_orig_speech_box_style <...>
}
script coop_orig_speech_box_style {
    RunScriptOnScreenElement id=<speech_text> hide_speech_text params=<...>
    DoMorph time=0 scale=(1.0, 1.0) alpha=1
    wait 4 frame
    DoMorph time=0.2 scale=(1.0, 1.0) alpha=1
    RunScriptOnScreenElement id=<speech_text> speech_box_style_scale_text params=<...>
}
script IntroCameraDescription {
    if CoopIsActive {
        if CoopIsHost {
            CoopSendSpawn call=coop_remote_intro_text params={<...>}
        }
    }
    coop_orig_IntroCameraDescription <...>
}
script coop_orig_IntroCameraDescription {
    if ! GotParam text {
        if ! GotParam goal {
            return
        }
    }
    KillSpawnedScript name=TemporarilyDisableInput
    SetButtonEventMappings block_menu_input
    if (<cam_index> = 0) {
        SpawnScript TemporarilyDisableInput params={time=1000}
    } else {
        SpawnScript TemporarilyDisableInput params={time=300}
    }
    if GotParam text {
        create_panel_block {id=intro_panel
            text=<text>
            rgba=[128 128 128 128]
            pos=(12.0, 395.0)
            time=<time>
            dims=(616.0, 0.0)
            just=[left center]
            internal_just=[center top]
            parent=root_window
        }
    } else {
        time2 = 1000000
        GoalManager_GetGoalParams name=<goal>
        FormatText TextName=goal_desc "\\c0%a - \\c5%b PTS." a=<view_goals_text> b=<reward_points>
        create_intro_panel_block {id=intro_panel
            text=<goal_desc>
            rgba=[8 97 121 128]
            pos=(12.0, 395.0)
            time=<time2>
            dims=(616.0, 0.0)
            just=[left center]
            internal_just=[center top]
            parent=root_window
            create_bg
        }
    }
    if GotParam cam_start_script {
        <cam_start_script>
    }
    while {
        if SkaterCamAnimFinished name=<name> {
            break
        }
        if intro_camera_event_handler:GetSingleTag pressed_x {
            intro_camera_event_handler:RemoveTags Tags=[pressed_x]
            KillSkaterCamAnim name=<name>
            break
        }
        wait 1 gameframes
    }
    if GotParam cam_end_script {
        <cam_end_script>
    }
    if ScreenElementExists id=intro_panel {
        DestroyScreenElement id=intro_panel
    }
    DeBounce x time=0.3
}
coop_debug_names = [TRG_Ped_Hawk TRG_Ped_Segway TRG_Ped_Segway_Intro TRG_Ped_TeammatePro TRG_Ped_TeammateIntroPro TRG_Ped_BenWaiting TRG_Ped_Gurney09 TRG_Ped_Sick_Kid TRG_Race_Ped TRG_Ped_Bum01]
script coop_debug_exists {
    GetArraySize coop_debug_names
    index = 0
    while {
        if ObjectExists id=(coop_debug_names [<index>]) {
            FormatText TextName=msg "debug: name %i exists" i=<index>
        } else {
            FormatText TextName=msg "debug: name %i missing" i=<index>
        }
        CoopLog <msg>
        index = (<index> + 1)
    } <array_size>
}
script coop_debug_unpause {
    CoopLog "debug: unpause all"
    UnpauseObjects
    UnpauseSkaters
    UnpauseSpawnedScripts
}
script PlayIntroCameras {
    if CoopIsActive {
        if ! CoopIsHost {
            if GotParam from_chapter_intro {
                DoChapterIntroCamSetup
                KillChapterMenu
                DoChapterIntroCamCleanup
                SafeCallback <...>
                coop_intro_hold
                return
            }
        }
    }
    coop_orig_PlayIntroCameras <...>
}
script coop_orig_PlayIntroCameras {
    if ! GotParam goal_intro_cameras {
        SafeCallback <...>
        return
    }
    if GotParam from_chapter_intro {
        DoChapterIntroCamSetup
    }
    GetArraySize <goal_intro_cameras>
    if (<array_size> > 0) {
        if GotParam from_cutscenes {
            fadetoblack on time=0 alpha=1.0
            wait 1 gameframes
            fadetoblack off time=0
        }
        SetUpChapterMenu
        if GotParam letterbox {
            fake_letterboxing
        }
        if CoopIsActive {
            if CoopIsHost {
                if GotParam letterbox {
                    CoopSendSpawn call=coop_remote_intro_begin params={letterbox}
                } else {
                    CoopSendSpawn call=coop_remote_intro_begin
                }
            }
        }
        if ! ScreenElementExists id=intro_camera_event_handler {
            CreateScreenElement {
                type=ContainerElement
                parent=root_window
                id=intro_camera_event_handler
                event_handlers=[{pad_choose story_intro_advance_cam}]
            }
        }
        FireEvent type=focus target=intro_camera_event_handler
        <index> = 0
        while {
            play_me = 1
            if StructureContains structure=(<goal_intro_cameras> [<index>]) goal {
                if GoalManager_HasWonGoal name=((<goal_intro_cameras> [<index>]).goal) {
                    play_me = 0
                }
            }
            if (<play_me> = 1) {
                PlayIntroSkaterCam index=<index> CAM=(<goal_intro_cameras> [<index>])
            }
            <index> = (<index> + 1)
        } <array_size>
        <index> = 0
        while {
            play_me = 1
            if StructureContains structure=(<goal_intro_cameras> [<index>]) goal {
                if GoalManager_HasWonGoal name=((<goal_intro_cameras> [<index>]).goal) {
                    play_me = 0
                }
            }
            if (<play_me> = 1) {
                GetIntroSkaterCamName index=<index> CAM=(<goal_intro_cameras> [<index>])
                IntroCameraDescription (<goal_intro_cameras> [<index>]) name=<name> cam_index=<index>
            }
            <index> = (<index> + 1)
        } <array_size>
        DestroyScreenElement id=intro_camera_event_handler
        printf "done with all cameras"
        fake_letterboxing remove
        if CoopIsActive {
            if CoopIsHost {
                CoopSendSpawn call=coop_remote_intro_end
            }
        }
        if ! GotParam from_chapter_intro {
            DisplayLoadingScreen freeze
            KillChapterMenu
            PauseMusicAndStreams 1
            wait 1 gameframes
            HideLoadingScreen
            pauseGame
            hide_all_hud_items
            DeBounce x time=0.3
            ingame_confirm_save no_script=ingame_save_return_to_game
            return
        }
        KillChapterMenu
        if GotParam from_cutscenes {
            fadetoblack on time=0 alpha=1
            wait 1 gameframes
            fadetoblack off time=0
        }
    }
    removeparameter goal_intro_cameras
    if GotParam from_chapter_intro {
        DoChapterIntroCamCleanup
    }
    SafeCallback <...>
}

script coop_debug_killcams {
    CoopLog "debug: kill all cams"
    KillSkaterCamAnim all
}
script beat_first_stat_goal {
    if CoopIsActive {
        if (bump_stats = 0) {
            return
        }
        create_panel_message id=coop_stat_msg text="Stat increased! Beating Stat Challenges raises your skills (pause > View Stats)." pos=(320.0, 120.0)
        return
    }
    coop_orig_beat_first_stat_goal <...>
}
script coop_orig_beat_first_stat_goal {
    printf "beat_first_stat_goal-----------------------------"
    if (bump_stats = 0) {
        return
    }
    pauseGame
    wait 1 gameframe
    PauseMusicAndStreams 1
    pause_trick_text
    pause_balance_meter
    pause_run_timer
    kill_blur
    if ObjectExists id=speech_box_anchor {
        RunScriptOnScreenElement id=speech_box_anchor hide_screen_element
    }
    if ScreenElementExists id=goal_start_dialog {
        DestroyScreenElement id=goal_start_dialog
    }
    if ObjectExists id=ped_speech_dialog {
        DestroyScreenElement id=ped_speech_dialog
    }
    if ObjectExists id=goal_retry_anchor {
        DestroyScreenElement id=goal_retry_anchor
    }
    hide_goal_panel_messages
    GoalManager_PauseAllGoals
    create_dialog_box {
        title="Stat Increased!"
        text="Beating Stat Challenges will increase your skating abilities. Pause the game and go to the View Stats menu to see a list of challenges."
        buttons=[{font=small text="Ok" pad_choose_script=kill_stat_goal_dialog}]
    }
    SpawnScript stats_message_kill_vibration
}

