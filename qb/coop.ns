script ChapterAdvanceDialog {
    if CoopIsActive {
        if ! CoopIsHost {
            if ScreenElementExists id=ped_speech_dialog {
                DestroyScreenElement id=ped_speech_dialog
            }
            coop_message text="Co-op: the host decides when the story moves on"
            if GotParam before_run {
                KillChapterMenu <...>
            }
            return
        }
    }
    coop_orig_ChapterAdvanceDialog <...>
}
script coop_orig_ChapterAdvanceDialog {
    GetCurrentChapter
    if ! StructureContains structure=(CHAPTER_INFO [<chapter>]) advance_ped_info {
        script_assert "This chapter is missing advance_ped_info....can't find the dialog text"
    }
    ped_info = (CHAPTER_INFO [<chapter>].advance_ped_info)
    if ScreenElementExists id=ped_speech_dialog {
        DestroyScreenElement id=ped_speech_dialog
    }
    if ! GotParam before_run {
        pauseGame
        PauseStream 1
        need_unpause_streams = need_unpause_streams
        hide_all_hud_items
        inside_run = inside_run
    } else {
        SetUpChapterMenu
    }
    CheckIfChapterIntrosViewed next
    if (<viewed> = 1) {
        buttons = [{font=small text=%"OK" pad_choose_script=KillChapterMenu
                pad_choose_params={callback=<callback> <...>}
            }
        ]
        title = (<ped_info>.name)
        text = (<ped_info>.already_moved_on_message)
    } else {
        CheckIfChapterUnlocked next
        if (<unlocked> = 0) {
            buttons = [{font=small text=%"OK" pad_choose_script=KillChapterMenu
                    pad_choose_params={callback=<callback> <...>}
                }
            ]
            title = (<ped_info>.name)
            text = (<ped_info>.need_more_points_message)
        } else {
            buttons = [{font=small text=%"No" pad_choose_script=KillChapterMenu
                    pad_choose_params={callback=<callback> <...>}
                }
                {font=small text=%"Yes" pad_choose_script=KillChapterMenu
                    pad_choose_params={callback=GotoNextChapterAccept}
                }
            ]
            title = (<ped_info>.name)
            text = (<ped_info>.move_on_now_message)
        }
    }
    create_snazzy_dialog_box {
        title=<title>
        text=<text>
        text_dims=(400.0, 0.0)
        no_bg
        buttons=<buttons>
    }
}

script level_select_change_level {
    if CoopIsActive {
        if ! CoopIsHost {
            if ! CoopIsRemote {
                if (<level> = Load_MainMenu) {
                    coop_orig_level_select_change_level <...>
                    return
                }
                coop_message text="Co-op: only the host changes the level"
                if ScreenElementExists id=level_select_anchor {
                    DestroyScreenElement id=level_select_anchor
                }
                exit_pause_menu
                return
            }
        }
    }
    coop_orig_level_select_change_level <...>
}
script coop_orig_level_select_change_level {
    GoalManager_ShowPoints
    if ! GoalManager_HasActiveGoals {
        GoalManager_ShowGoalPoints
    }
    if ScreenElementExists id=level_select_anchor {
        DestroyScreenElement id=level_select_anchor
        load_level_select_textures_to_main_memory unload
    }
    if ScreenElementExists id=current_menu_anchor {
        DestroyScreenElement id=current_menu_anchor
    }
    if LevelIs Load_sk5ed {
        load_parked_textures_to_main_memory unload
    }
    if LevelIs Load_MainMenu {
        SetColorBufferClear clear=0
    }
    if LevelIs load_sk5ed_gameplay {
        RailEditor:DestroyEditedRailSectors DoNotUpdateSuperSectors
    }
    kill_level_select_cams
    if GameModeEquals is_career {
        if ! GotParam dont_end_chapter {
            SetHighestChapterWithLevel level=<level>
        }
        if ! LevelIs Load_MainMenu {
            if ((<level> = load_boardshop) or (<level> = load_cas)) {
                temp = <level>
                GetCurrentLevel
                array = return_to_level
                SetArrayElement ArrayName=array index=0 newvalue=<level>
                level = <temp>
            }
        }
    }
    if InNetGame {
        show_warning = 1
    }
    if CD {
        if IsCustomPark {
            if isNGC {
                DisplayLoadingScreen blank
            }
            really_change_level <...>
        } else {
            if ! LevelIs <level> {
                if isNGC {
                    DisplayLoadingScreen blank
                }
                really_change_level <...>
            } else {
                if GotParam chose_same_level_script {
                    <chose_same_level_script>
                } else {
                    if root_window:GetSingleTag no_exit_pause_menu {
                        level_select_menu_exit
                        return
                    }
                    if GotParam end_run {
                        level_select_menu_exit end_run
                        return
                    }
                    if InSplitScreenGame {
                        level_select_menu_exit end_run
                        return
                    }
                }
            }
        }
    } else {
        really_change_level <...>
    }
    level_select_menu_exit no_new_menu
    exit_pause_menu
}

