script goal_accept_trigger {
    if CoopIsActive {
        if ! CoopIsRemote {
            if CoopSharedGoal goal_id=<goal_id> mode=waiting {
                speech_box_exit anchor_id=goal_start_dialog
                create_panel_message id=coop_goal_msg text="You've done this goal - waiting for your friend to finish it" pos=(320.0, 120.0) time=5000
                return
            }
        }
    }
    coop_orig_goal_accept_trigger <...>
    if CoopIsActive {
        if ! CoopIsRemote {
            if GoalManager_GoalIsActive name=<goal_id> {
                CoopSharedGoal goal_id=<goal_id> mode=start
            }
        }
    }
}
script coop_orig_goal_accept_trigger {
    DeBounce x time=0.5
    speech_box_exit anchor_id=goal_start_dialog
    goal_check_for_required_tricks goal_id=<goal_id>
    <trigger_exists> = 0
    if GotParam trigger_obj_id {
        if NodeExists <trigger_obj_id> {
            <trigger_exists> = 1
        }
    }
    if GotParam force_start {
        if ! GoalManager_GoalInitialized name=<goal_id> {
            GoalManager_InitializeGoal name=<goal_id>
        }
        if (<trigger_exists> = 1) {
            GoalManager_ResetGoalTrigger name=<goal_id> no_new_exceptions
            if IsAlive name=<trigger_obj_id> {
                <trigger_obj_id>:Obj_ClearException ObjectInRadius
            }
        }
        GoalManager_DeactivateAllGoals
        GoalManager_ActivateGoal name=<goal_id> <...>
        return
    }
    if ! SkaterCurrentScorePotGreaterThan 0 {
        if GoalManager_CanStartGoal name=<goal_id> {
            GetSkaterId
            if <objId>:OnGround {
                if SkaterCurrentScorePotLessThan 1 {
                    if <objId>:OnGround {
                        GoalManager_GetGoalParams name=<goal_id>
                        if (<trigger_exists> = 1) {
                            GoalManager_ResetGoalTrigger name=<goal_id> no_new_exceptions
                            if IsAlive name=<trigger_obj_id> {
                                <trigger_obj_id>:Obj_ClearException ObjectInRadius
                            }
                        }
                        GoalManager_DeactivateAllGoals
                        if GotParam quick_start {
                            GoalManager_QuickStartGoal name=<goal_id>
                        } else {
                            GoalManager_ActivateGoal name=<goal_id> <...>
                        }
                    } else {
                        if ! <objId>:RightPressed {
                            if ! <objId>:LeftPressed {
                                if ! <objId>:UpPressed {
                                    if ! <objId>:DownPressed {
                                        GoalManager_GetGoalParams name=<goal_id>
                                        if (<trigger_exists> = 1) {
                                            GoalManager_ResetGoalTrigger name=<goal_id> no_new_exceptions
                                            if IsAlive name=<trigger_obj_id> {
                                                <trigger_obj_id>:Obj_ClearException ObjectInRadius
                                            }
                                        }
                                        GoalManager_DeactivateAllGoals
                                        if GotParam quick_start {
                                            GoalManager_QuickStartGoal name=<goal_id>
                                        } else {
                                            GoalManager_ActivateGoal name=<goal_id> <...>
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                if ! <objId>:RightPressed {
                    if ! <objId>:LeftPressed {
                        if ! <objId>:UpPressed {
                            if ! <objId>:DownPressed {
                                GoalManager_GetGoalParams name=<goal_id>
                                if (<trigger_exists> = 1) {
                                    GoalManager_ResetGoalTrigger name=<goal_id> no_new_exceptions
                                    if IsAlive name=<trigger_obj_id> {
                                        <trigger_obj_id>:Obj_ClearException ObjectInRadius
                                    }
                                }
                                GoalManager_DeactivateAllGoals
                                if GotParam quick_start {
                                    GoalManager_QuickStartGoal name=<goal_id>
                                } else {
                                    GoalManager_ActivateGoal name=<goal_id> <...>
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
script coop_remote_start_goal {
    if GoalManager_HasActiveGoals {
        create_panel_message id=coop_goal_msg text="Your friend took a goal - finish yours to join in" pos=(320.0, 120.0) time=6000
        return
    }
    if ! GoalManager_GoalInitialized name=<goal_id> {
        GoalManager_InitializeGoal name=<goal_id>
    }
    GoalManager_DeactivateAllGoals
    GoalManager_ActivateGoal name=<goal_id>
    if GoalManager_GoalIsActive name=<goal_id> {
        CoopSharedGoal goal_id=<goal_id> mode=joined
        CoopSendSpawn call=coop_remote_goal_joined params={goal_id=<goal_id>}
    }
}
script coop_remote_goal_joined {
    CoopSharedGoal goal_id=<goal_id> mode=joined
}
script coop_goal_done_wait {
    if GoalManager_GoalIsActive name=<goal_id> {
        GoalManager_DeactivateGoal name=<goal_id>
    }
    create_panel_message id=coop_goal_msg text="Goal done! Waiting for your friend to finish it too." pos=(320.0, 120.0) time=6000
}
script coop_peer_goal_done {
    if GoalManager_GoalIsActive name=<goal_id> {
        create_panel_message id=coop_goal_msg text="Your friend finished this goal - finish it too!" pos=(320.0, 120.0) time=6000
    } else {
        create_panel_message id=coop_goal_msg text="Your friend finished a shared goal - take it again to finish it too" pos=(320.0, 120.0) time=6000
    }
}

script UnloadAnimsAndCreateMemCardPools {
    if ! LevelIs Load_MainMenu {
        if ! LevelIs Load_sk5ed {
            change DebugPausedObjects=1
            if CoopIsActive {
                CoopLog "save menu: animations kept loaded (co-op)"
            } else {
                do_unload_unloadable
            }
            if ! isNGC {
                CreateTemporaryMemCardPools
            }
        }
    }
}

script coop_goal_won_chain {
    GoalManager_GetGoalParams name=<goal_id>
    if GotParam child {
        <frames> = 0
        while {
            if GoalManager_GoalIsActive name=<child> {
                CoopSharedGoal goal_id=<child> mode=joined
                break
            }
            if (<frames> > 120) {
                CoopLog "shared goals: the next stage didn't start"
                break
            }
            <frames> = (<frames> + 1)
            wait 1 gameframe
        }
    }
}

script maybe_auto_load_from_memory_card {
    FormatText TextName=t "autoload: DoAutoload=%d" d=DoAutoload
    CoopLog <t>
    coop_orig_maybe_auto_load_from_memory_card <...> force_autoload
}
script coop_orig_maybe_auto_load_from_memory_card {
    if (DoAutoload = 0) {
        SpawnScript wait_and_pause_skater params={time=1 dont_pause_music=1}
        if ConnectedToPeer {
            SetNetworkMode INTERNET_MODE
            change_gamemode_net
            SetQuietMode off
            rejoin_lobby
            kill_start_key_binding
        } else {
            launch_main_menu
        }
    } else {
        change DoAutoload=0
        if IsInternetGameHost {
            CheckForCardOnBootup
        } else {
            if IsJoiningInternetGame {
                CheckForCardOnBootup
            } else {
                if ! isXbox {
                    if ! GotParam force_autoload {
                        wait 3 gameframes
                        if ! PadsPluggedIn {
                            goto back_to_main_menu2
                        }
                        SpawnScript wait_and_pause_skater
                        goto back_to_main_menu2
                    } else {
                        SpawnScript wait_and_pause_skater params={time=1}
                        CheckForCardOnBootup
                    }
                } else {
                    SpawnScript wait_and_pause_skater
                    CheckForCardOnBootup
                }
            }
        }
    }
}

script coop_debug_stop_goals {
    GoalManager_DeactivateAllGoals
    CoopLog "debug: goals stopped"
}
script coop_debug_goto_mullen {
    ResetSkaters node_name=TRG_G_Counter_RESTARTNODE
    CoopLog "debug: at Mullen's goal start"
}
script coop_debug_load_save {
    SetSectionsToApplyWhenLoading All
    if LoadFromMemoryCard name=<name> type=OptionsAndPros {
        CoopLog "debug: save loaded"
    } else {
        CoopLog "debug: save load failed"
    }
}

script enter_kb_chat {
    create_onscreen_keyboard allow_cancel no_buttons pos=(320.0, 260.0) keyboard_done_script=coop_chat_done keyboard_cancel_script=coop_chat_cancel display_text="ENTER MESSAGE: " keyboard_title="ENTER MESSAGE" min_length=0 max_length=127 display_text_scale=0.5
    if ScreenElementExists id=keyboard_anchor {
        keyboard_anchor:SetTags coop_chat
    }
}
script coop_chat_done {
    GetTextElementLength id=keyboard_current_string
    if (<length> = 0) {
        destroy_onscreen_keyboard
    } else {
        entered_chat_message
    }
}
script coop_chat_cancel {
    destroy_onscreen_keyboard
}
script coop_chat_escape {
    if ScreenElementExists id=keyboard_anchor {
        if keyboard_anchor:GetSingleTag coop_chat {
            CoopLog "chat: closed with Esc"
            destroy_onscreen_keyboard
        }
    }
}
script coop_leave_confirm {
    create_panel_message id=coop_status_msg text=<text> pos=(320.0, 80.0) time=4000
}
script coop_host_leave {
    CoopLog "host: leaving co-op"
    exit_pause_menu
    if LevelIs Load_MainMenu {
        chosen_leave_server
        CoopSetRole 0
        coop_message text="Co-op: closed"
        return
    }
    coop_message text="Co-op: closed - reloading the level for single player"
    <frames> = 0
    while {
        if ! CoopLinkUp {
            break
        }
        <frames> = (<frames> + 1)
        if (<frames> > 600) {
            CoopLog "host: the friend didn't leave in 10 s"
            break
        }
        wait 1 gameframe
    }
    wait 60 gameframes
    GetCurrentLevel
    coop_level = <level>
    GoalManager_DeactivateAllGoals
    goalmanager_levelunload
    cleanup preserve_skaters
    chosen_leave_server
    CoopSetRole 0
    FlushDeadObjects
    SetGameType career
    SetCurrentGameType
    setservermode on
    StartServer
    SetJoinMode JOIN_MODE_PLAY
    JoinServer
    while {
        if JoinServerComplete {
            break
        } else {
            wait 1
        }
    }
    change_level level=<coop_level>
}
script coop_client_leave {
    CoopLog "client: leaving co-op"
    exit_pause_menu
    dialog_box_exit
    PauseObjects
    quit_network_game
    UnpauseObjects
    wait 60 gameframes
    coop_message text="Co-op: you left the host's game"
}
script coop_after_goal_won {
    wait 60 gameframes
    <frames> = 0
    while {
        if SkaterCamAnimFinished {
            break
        }
        <frames> = (<frames> + 1)
        if (<frames> > 1800) {
            break
        }
        wait 1 gameframe
    }
    wait 90 gameframes
    if GoalManager_HasActiveGoals {
        return
    }
    if (coop_cam_frozen = 1) {
        return
    }
    skater:EnablePlayerInput
    CoopLog "after a goal: the player's input is on"
}
script coop_debug_save_test {
    CoopLog "debug: save test"
    UnloadAnimsAndCreateMemCardPools
    if SaveToMemoryCard name="coop night test" type=OptionsAndPros {
        CoopLog "debug: save test ok"
    } else {
        CoopLog "debug: save test failed"
    }
    DestroyTemporaryMemCardPools
}
