script coop_lobby_open_message {
    wait 2 gameframes
    <frames> = 0
    while {
        if (is_changing_levels = 0) {
            break
        }
        <frames> = (<frames> + 1)
        if (<frames> > 600) {
            break
        }
        wait 1 gameframe
    }
    wait 20 gameframes
    coop_message text="Co-op lobby open: friend can join, then start Story"
}
script coop_message {
    create_panel_message id=coop_status_msg text=<text> pos=(320.0, 80.0)
}
script coop_host_start {
    if CoopIsActive {
        coop_message text="Co-op is already running"
    } else {
        coop_in_story = 0
        if GameModeEquals is_career {
            if ! LevelIs Load_MainMenu {
                coop_in_story = 1
            }
        }
        if (<coop_in_story> = 0) {
            if LevelIs Load_MainMenu {
                CoopSetRole 1
                coop_apply_name
                CoopLog "host: lobby open"
                cleanup preserve_skaters
                chosen_leave_server
                FlushDeadObjects
                InitSkaterHeaps
                SetNetworkMode LAN_MODE
                setservermode on
                StartServer
                SetJoinMode JOIN_MODE_PLAY
                JoinServer
                while {
                    if JoinServerComplete {
                        break
                    } else {
                        wait 1
                    }
                }
                change_level level=Load_MainMenu
                CoopLog "host: lobby server up"
                coop_lobby_open_message
            } else {
                coop_message text="Co-op: start Story mode first, then open co-op again"
            }
        } else {
            coop_apply_name
            CoopLog "host: start"
            coop_message text="Co-op: hosting..."
            GetCurrentLevel
            coop_level = <level>
            CoopSetRole 1
            GoalManager_DeactivateAllGoals
            goalmanager_levelunload
            skater:ResetSkaterToCustom
            cleanup preserve_skaters
            chosen_leave_server
            FlushDeadObjects
            InitSkaterHeaps
            SetGameType career
            SetCurrentGameType
            SetNetworkMode LAN_MODE
            setservermode on
            StartServer
            SetJoinMode JOIN_MODE_PLAY
            JoinServer
            while {
                if JoinServerComplete {
                    break
                } else {
                    wait 1
                }
            }
            CoopLog "host: server up, reloading level"
            change_level level=<coop_level>
        }
    }
}
script coop_join_start {
    if CoopIsActive {
        coop_message text="Co-op is already running"
    } else {
        coop_apply_name
        CoopLog "client: start"
        coop_message text="Co-op: connecting to the host..."
        CoopSetRole 2
        if ! CoopConnect {
            coop_message text="Co-op: can't reach the host (check host_address in coop.ini)"
            CoopSetRole 0
        } else {
            coop_message text="Co-op: connected - waiting for the host to start the story"
            while {
                if CoopShouldJoin {
                    break
                }
                if ! CoopLinkUp {
                    break
                }
                wait 1 gameframe
            }
            if ! CoopShouldJoin {
                coop_message text="Co-op: the host closed the connection"
                CoopSetRole 0
            } else {
                coop_message text="Co-op: joining..."
                GoalManager_DeactivateAllGoals
                goalmanager_levelunload
                cleanup preserve_skaters
                chosen_leave_server
                FlushDeadObjects
                InitSkaterHeaps
                SetGameType career
                SetCurrentGameType
                SetNetworkMode LAN_MODE
                setservermode off
                SetJoinMode JOIN_MODE_PLAY
                CoopJoin
                CoopLog "client: join sent"
            }
        }
    }
}
script coop_play_cutscene {
    PlayCutscene <...>
}
coop_debug_peds = [TRG_Tony_Advance TRG_SkitchATVDriver TRG_RodneySkate_01 TRG_MikeSkate_01 TRG_BobSkate_01 TRG_EricSkate_01 TRG_BamSkate_01 TRG_MuskaSkate_01 TRG_G_COUNTER_PRO TRG_g_ped_counter6]
script coop_debug_f9 {
    GetArraySize coop_debug_peds
    index = 0
    found = 0
    while {
        ped = (coop_debug_peds [<index>])
        if ObjectExists id=<ped> {
            FormatText TextName=msg "debug: ped %i exists" i=<index>
            CoopLog <msg>
            if (<found> = 2) {
                found = 1
                if SwapObjectModels obj_1=skater obj_2=<ped> {
                    FormatText TextName=msg "debug: swapped with ped %i" i=<index>
                    CoopLog <msg>
                }
            }
        } else {
            FormatText TextName=msg "debug: ped %i missing" i=<index>
            CoopLog <msg>
        }
        index = (<index> + 1)
    } <array_size>
}
script coop_debug_f8 {
    CoopLog "debug: win TR_Goal_Gaps27"
    GoalManager_WinGoal name=TR_Goal_Gaps27
}
